# ============================================================
# 复制本文件为 .env 并填入真实值。切勿把 .env 提交到仓库。
# LLM / Embedding API Key 属于敏感信息，泄露后请立即轮换。
# ============================================================

# --- LLM（对话 / 总结 / 重写） ---
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash

# --- Embedding ---
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxx

# --- Rerank（阿里云 DashScope） ---
DASHSCOPE_API_KEY=sk-xxx

# --- PostgreSQL / PgBouncer ---
# 应用通过 pgbouncer(6432) 连接；直连 postgres 用 15432（仅本机）
POSTGRES_APP_USER=quantkb
POSTGRES_APP_PASSWORD=<db-password>
POSTGRES_READONLY_USER=kbquant_readonly
POSTGRES_READONLY_PASSWORD=<readonly-password>
DATABASE_URL=postgresql+asyncpg://quantkb:<db-password>@localhost:6432/quant_kb
DATABASE_READ_URL=postgresql+asyncpg://quantkb:<db-password>@localhost:6432/quant_kb
DATABASE_URL_SYNC=postgresql+psycopg2://quantkb:<db-password>@localhost:6432/quant_kb

# --- Elasticsearch（docker-compose 开启 security 后必填） ---
ELASTIC_PASSWORD=<es-elastic-password>
ES_APP_USER=quantkb
ES_APP_PASSWORD=<es-app-password>
ES_READONLY_USER=kbquant_es_readonly
ES_READONLY_PASSWORD=<es-readonly-password>

# --- 服务 ---
API_KEY=<your-api-key>
UVICORN_WORKERS=8

# --- 其他集成 ---
GITEE_API_KEY=<gitee-token>
